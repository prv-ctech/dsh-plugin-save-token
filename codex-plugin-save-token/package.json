  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "save-token-mcp": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "setup": "node scripts/install.mjs",
    "stats": "node scripts/stats.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "src",
    "scripts",
    "skill",
    "skill-dashboard",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "codex",
    "codex-cli",
    "codex-plugin",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "token-optimization",
    "llm",
